# HPZ website — server-side environment variables.
# These are set in the Vercel dashboard (Project → Settings → Environment Variables).
# NEVER commit real values. This file documents the names only.

# --- Required: lead storage ---
# Supabase project REST URL. Defaults to the HPZ project if unset.
SUPABASE_URL=https://ypfooffkoiuumqnwraxu.supabase.co
# Supabase SERVICE ROLE key. Server-side only — never expose to the browser.
# Supabase dashboard → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- Required: welcome email ---
# resend.com → API Keys. Without this, signups still work; the welcome email is skipped.
RESEND_API_KEY=
# Must use a domain verified in Resend once DNS is set up.
# Until then Resend's shared sender works for testing: HPZ Performance <onboarding@resend.dev>
EMAIL_FROM=HPZ Performance <hello@hpzperformance.com>
EMAIL_REPLY_TO=hpzperformancezone@gmail.com
EMAIL_PROVIDER=resend

# --- Optional ---
# Random string used to salt IP hashes. Set any long random value.
LEAD_IP_SALT=
